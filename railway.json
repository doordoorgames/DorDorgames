{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm run build:api",
    "watchPatterns": [
      "artifacts/api-server/**",
      "lib/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig*.json"
    ]
  },
  "deploy": {
    "startCommand": "cd artifacts/api-server && node --enable-source-maps ./dist/index.mjs",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100
  }
}
