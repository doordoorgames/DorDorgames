{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "PORT=4173 BASE_PATH=/ pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tfadhloon-api-server.vercel.app/api/:path*"
    }
  ]
}
