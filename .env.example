PORT=3000
CLIENT_ORIGIN=https://dordor.games,https://www.dordor.games,https://spy.dordor.games,https://tfadhloon.dordor.games,https://guessyourword.dordor.games,https://guessthecharacter.dordor.games,https://charades.dordor.games

DATABASE_URL=postgresql://user:password@host:5432/database
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SECRET_KEY=your-server-secret-key
SESSION_SECRET=replace-with-a-long-random-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_TOKEN=replace-with-a-long-random-admin-token

TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid

# Frontend build variables. Use a first-party API subdomain so secure login
# cookies work across all Dordor game sites.
VITE_API_BASE_URL=https://dordorgames-production.up.railway.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
