PORT=3000
CLIENT_ORIGIN=https://dordor.games,https://www.dordor.games,https://spy.dordor.games,https://tfadhloon.dordor.games,https://guessyourword.dordor.games,https://guessthecharacter.dordor.games,https://charades.dordor.games

DATABASE_URL=postgresql://user:password@host:5432/database
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SECRET_KEY=your-server-secret-key
SESSION_SECRET=replace-with-a-long-random-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_TOKEN=replace-with-a-long-random-admin-token

TURNSTILE_SECRET_KEY=your-turnstile-secret
TURNSTILE_ALLOWED_HOSTNAMES=www.dordor.games
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# MyFatoorah sandbox example. Use the live token and https://api.myfatoorah.com only in production.
MYFATOORAH_API_TOKEN=your-demo-token
MYFATOORAH_API_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_WEBHOOK_SECRET=your-demo-webhook-secret
PAYMENT_APP_URL=https://www.dordor.games
PAYMENT_API_URL=https://dordorgames-production.up.railway.app

# Frontend build variables. Use a first-party API subdomain so secure login
# cookies work across all Dordor game sites.
VITE_API_BASE_URL=https://dordorgames-production.up.railway.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
