{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20",
    "pnpm": "9.15.9"
  },
  "steps": {
    "install": {
      "commands": [
        "pnpm install --no-frozen-lockfile"
      ]
    },
    "build": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": [
        "pnpm run build:api"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd artifacts/api-server && node --enable-source-maps ./dist/index.mjs"
  }
}
